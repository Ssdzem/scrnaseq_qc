# Snakefile for reproducible top-level a1_p1_qc figures.


def _figures_cfg() -> dict:
    cfg = config.get("figures", {}) if isinstance(config, dict) else {}
    return cfg if isinstance(cfg, dict) else {}


def _figures_h5ad() -> str:
    explicit = str(_figures_cfg().get("h5ad", "")).strip()
    if explicit:
        return explicit
    return "out/integration_annotation/all_studies/all_annotated.h5ad"


P1_FIGURE_OUTPUTS = [
    "out/figures/01_umap_study_accession.png",
    "out/figures/02_unique_samples_by_fibrosis_stage.png",
    "out/figures/03_unique_samples_by_study_accession.png",
    "out/figures/04_cell_type_study_composition.png",
    "out/figures/manifest.json",
]

include: "rules/figures.smk"
