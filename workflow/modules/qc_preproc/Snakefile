# Snakefile for qc_preproc module (keep minimal; include rules).

from pathlib import Path


def _profile_module_config(filename: str, explicit_key: str) -> str:
    """Resolve module config from an active profile, otherwise config/."""
    explicit = str(config.get(explicit_key, "")).strip()
    if explicit:
        return explicit

    profile_dir = str(config.get("profile_config_dir", "")).strip()
    if profile_dir:
        profile_cfg = Path(profile_dir) / filename
        if profile_cfg.exists():
            return str(profile_cfg)

    return str(Path("config") / filename)


QC_CONFIG_PATH = _profile_module_config("qc.yaml", "qc_config")

configfile: QC_CONFIG_PATH

include: "rules/qc_preproc.smk"

# Keep ruleorder aligned with rules that actually exist in this module.
ruleorder: qc_all > qc_all_pre_integration > qc_study_pre_integration > qc_pretrim_pictures > qc_attach_metadata > qc_concat_all_raw
