# Snakefile for integration_annotation module (keep minimal; include rules).

from pathlib import Path


def _profile_module_config(filename: str, explicit_key: str) -> str:
    """Resolve module config from an active profile, otherwise config/.

    Profiles can set `--config profile_config_dir=profiles/<name>` (for example
    from profiles/<name>/config.yaml). If profiles/<name>/<filename> exists,
    that file becomes the module config. Otherwise the default config/<filename>
    remains the canonical template/fallback. An explicit config key can override
    both for one-off dry-runs.
    """
    explicit = str(config.get(explicit_key, "")).strip()
    if explicit:
        return explicit

    profile_dir = str(config.get("profile_config_dir", "")).strip()
    if profile_dir:
        profile_cfg = Path(profile_dir) / filename
        if profile_cfg.exists():
            return str(profile_cfg)

    return str(Path("config") / filename)


IA_CONFIG_PATH = _profile_module_config("integration_annotation.yaml", "integration_annotation_config")

configfile: IA_CONFIG_PATH

wildcard_constraints:
    study=r"(?!all_studies$)[^/]+"

include: "rules/common.smk"
include: "rules/integrate.smk"
include: "rules/reference_atlas.smk"
include: "rules/annotate.smk"
include: "rules/evaluate.smk"
include: "rules/finalize.smk"

ruleorder: integration_annotation_all > ia_evaluate_all > ia_annotate_all > ia_integrate_all > integration_annotation_study > ia_evaluate_study > ia_annotate_study > ia_integrate_study
